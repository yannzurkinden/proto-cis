# =============================================================================
# CIS - Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in the actual values.
# NEVER commit .env.production to version control.
# =============================================================================

# === Application ===
APP_NAME=CIS
DEBUG=false
ALLOWED_ORIGINS=https://cis.example.ch

# === Database ===
DATABASE_URL=postgresql+asyncpg://cis:CHANGE_ME_STRONG_PASSWORD@db:5432/cis
POSTGRES_DB=cis
POSTGRES_USER=cis
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === Security ===
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === MinIO (S3-compatible storage) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG
MINIO_BUCKET=cis-documents
MINIO_SECURE=false

# === SMTP (Infomaniak) ===
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=noreply@example.ch
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.ch

# === Logging ===
LOG_LEVEL=INFO
